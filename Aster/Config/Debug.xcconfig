#include "Shared.xcconfig"
DEBUG_INFORMATION_FORMAT = dwarf
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
GCC_OPTIMIZATION_LEVEL = 0
SWIFT_OPTIMIZATION_LEVEL = -Onone
// Network Extension processes run from a read-only bundle. Disable Xcode's
// coverage instrumentation for device Debug builds so LLVM does not try to
// write default.profraw inside PacketTunnel.appex at shutdown.
CLANG_ENABLE_CODE_COVERAGE = NO
GCC_GENERATE_TEST_COVERAGE_FILES = NO
ENABLE_CODE_COVERAGE = NO
PRIVACY_POLICY_URL = https:/$()/example.invalid/aster-vpn/privacy
NODE_SUBSCRIPTION_URL =
